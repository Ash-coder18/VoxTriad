# ============================================================
# VoxTriad Backend – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Supabase project credentials
# Found at: https://app.supabase.com → Project Settings → API
# ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----------------------------------------------------------
# Supabase service-role key (server-side only – keep secret)
# ----------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------
# Google Gemini API key (used in Phase 2+ for LLM analysis)
# Obtain at: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=

# ----------------------------------------------------------
# Application settings
# ----------------------------------------------------------
# Environment: development | staging | production
APP_ENV=development

# CORS – comma-separated list of allowed frontend origins
# (leave as default for local dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500
